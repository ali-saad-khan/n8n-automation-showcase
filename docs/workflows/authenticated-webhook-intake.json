{
  "name": "Authenticated Webhook Intake",
  "nodes": [
    {
      "parameters": {
        "content": "## POST /webhook/intake\nHeader x-api-key must equal $env.INTAKE_API_KEY -> 401 otherwise. Body needs name, email, message -> 400 otherwise. Valid: normalise, enrich via sub-workflow, store in Data Table, respond 200.\nSet the sub-workflow ID and Data Table ID after import.",
        "width": 1300,
        "height": 100,
        "color": 4
      },
      "id": "b01707c7-df7d-4027-a823-82c4d8b11f95",
      "name": "Note: Overview",
