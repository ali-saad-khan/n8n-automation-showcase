              "rightValue": "={{ $env.INTAKE_API_KEY }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "211ef165-ec80-4b7e-ad58-6d07795d2ce5",
              "leftValue": "={{ $env.INTAKE_API_KEY }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "85fcc475-5f21-48ef-a7ae-2447e79941d7",
