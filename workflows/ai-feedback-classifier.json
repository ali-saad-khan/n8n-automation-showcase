{
  "name": "AI Feedback Classifier",
  "nodes": [
    {
      "parameters": {
        "content": "## POST /webhook/feedback  { \"message\": \"...\" }\nLocal Ollama classifies sentiment / category / urgency into a validated JSON schema. High urgency pings on-call. LLM failure -> error branch -> 503 with needs_human_review.\nCreate an Ollama credential (base URL e.g. http://host.docker.internal:11434) and pull the model first.",
        "width": 1500,
        "height": 100,
        "color": 4
      },
      "id": "0dfe5be5-20a3-4eac-a3a7-87d93810713c",
      "name": "Note: Overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -100
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "feedback",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a52f6609-92bf-4c28-a84d-427f20f25d84",
      "name": "Feedback Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        200
      ],
      "webhookId": "15764b5b-6fae-44d7-a746-cc87606742f8"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "577f900a-6b11-4b45-a161-6897dacb6050",
              "leftValue": "={{ $json.body.message }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "247894c4-c42f-462a-a065-0e9616e61f0b",
      "name": "Has Message?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'error', error: 'message is required' } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "2d477937-6e65-460c-a4b4-2d1e311c9fbe",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        220,
        340
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a support triage assistant. Classify the customer feedback. sentiment: positive|neutral|negative. category: bug|feature_request|billing|praise|other. urgency: low|medium|high (high = outage, data loss, security, or churn threat). Add a one-sentence summary. Respond only with the requested JSON."
            }
          ]
        }
      },
      "id": "38678fa1-753a-4588-a89f-10032c9ac89e",
      "name": "Classify Feedback",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        440,
        160
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": "llama3.1:8b",
        "options": {
          "temperature": 0
        }
      },
      "id": "4b215f3c-a817-4640-a2fd-71611213eaeb",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        300,
        480
      ],
      "credentials": {
        "ollamaApi": {
          "id": "REPLACE_ME",
          "name": "Ollama (local)"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"sentiment\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"positive\",\n        \"neutral\",\n        \"negative\"\n      ]\n    },\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"bug\",\n        \"feature_request\",\n        \"billing\",\n        \"praise\",\n        \"other\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"sentiment\",\n    \"category\",\n    \"urgency\",\n    \"summary\"\n  ]\n}"
      },
      "id": "ba79ee86-6717-4e9f-addf-dbb3411ea859",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        560,
        480
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "79858ba9-4b3b-4703-af6f-70ba4dd1d66a",
              "name": "sentiment",
              "value": "={{ $json.output.sentiment }}",
              "type": "string"
            },
            {
              "id": "48282a88-0cdb-4a37-a78c-4a48aedcc200",
              "name": "category",
              "value": "={{ $json.output.category }}",
              "type": "string"
            },
            {
              "id": "850cd182-cb88-43c6-a14f-51ec8279077c",
              "name": "urgency",
              "value": "={{ $json.output.urgency }}",
              "type": "string"
            },
            {
              "id": "67810024-2438-4ad5-ac6c-54d73677a33c",
              "name": "summary",
              "value": "={{ $json.output.summary }}",
              "type": "string"
            },
            {
              "id": "e2df6500-988b-4d4e-a6f8-050fb751ac91",
              "name": "needs_human_review",
              "value": "false",
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "7aa862de-6b1d-4339-ad12-a028f4001c9f",
      "name": "Shape Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "34f57d7a-d05b-44d7-a46a-e1752fe7c319",
              "leftValue": "={{ $json.urgency }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7e94450b-11e8-45c7-a275-21af49236727",
      "name": "Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ALERT_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { text: 'High-urgency feedback (' + $json.category + '): ' + $json.summary } }}",
        "options": {}
      },
      "id": "629afd9f-b409-4170-a302-49456804fca4",
      "name": "Notify On-call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        20
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'classified', sentiment: $('Shape Result').item.json.sentiment, category: $('Shape Result').item.json.category, urgency: $('Shape Result').item.json.urgency, summary: $('Shape Result').item.json.summary } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "c7fe4183-53f6-4e63-abc7-e88594963631",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1360,
        100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "33a7fb93-6eb1-416f-a8c5-4a8da2c38572",
              "name": "status",
              "value": "classification_failed",
              "type": "string"
            },
            {
              "id": "0969527f-cb73-43c3-afd3-01524f9dfd63",
              "name": "needs_human_review",
              "value": "true",
              "type": "boolean"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "d04bbaa2-cf87-4211-abf3-75a5f7009078",
      "name": "Fallback Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        260
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: $json.status, needs_human_review: $json.needs_human_review } }}",
        "options": {
          "responseCode": 503
        }
      },
      "id": "7934b35d-c359-4144-aae2-11dcb06552fe",
      "name": "Respond 503",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        920,
        260
      ]
    }
  ],
